{"call":{"arguments":{"limit":200,"offset":0,"path":"search2.py"},"consumed_episode_ids":[],"depends_on_call_ids":[],"id":"call_01a1a22cf1cd73c187669442","name":"read_file"},"result":{"error":null,"failure":null,"output":{"lines":[{"line":1,"text":"import urllib.request, urllib.parse, re, html, json, ssl"},{"line":2,"text":""},{"line":3,"text":"UA = {'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36',"},{"line":4,"text":"      'Accept-Language': 'en-US,en;q=0.9'}"},{"line":5,"text":""},{"line":6,"text":"def fetch(u):"},{"line":7,"text":"    req = urllib.request.Request(u, headers=UA)"},{"line":8,"text":"    with urllib.request.urlopen(req, timeout=25) as r:"},{"line":9,"text":"        return r.status, r.read().decode('utf-8', 'ignore')"},{"line":10,"text":""},{"line":11,"text":"def clean(t):"},{"line":12,"text":"    t = re.sub(r'<script.*?</script>', ' ', t, flags=re.S|re.I)"},{"line":13,"text":"    t = re.sub(r'<style.*?</style>', ' ', t, flags=re.S|re.I)"},{"line":14,"text":"    t = re.sub(r'<[^>]+>', ' ', t)"},{"line":15,"text":"    t = html.unescape(t)"},{"line":16,"text":"    return re.sub(r'\\s+', ' ', t).strip()"},{"line":17,"text":""},{"line":18,"text":"queries = ["},{"line":19,"text":"    '\"Duan Yihe\" NUS',"},{"line":20,"text":"    '\"Duan Yihe\" \"Electrical and Computer Engineering\"',"},{"line":21,"text":"    'site:nus.edu.sg \"Duan Yihe\"',"},{"line":22,"text":"    'site:comp.nus.edu.sg \"Duan Yihe\"',"},{"line":23,"text":"    'site:ece.nus.edu.sg \"Duan Yihe\"',"},{"line":24,"text":"    '\"Yihe Duan\" NUS',"},{"line":25,"text":"    '\"Duan Yihe\" Singapore',"},{"line":26,"text":"    '\"Yihe Duan\" electrical computer engineering',"},{"line":27,"text":"]"},{"line":28,"text":""},{"line":29,"text":"engines = {"},{"line":30,"text":"  'ddg': 'https://html.duckduckgo.com/html/?q={}',"},{"line":31,"text":"  'bing': 'https://www.bing.com/search?q={}',"},{"line":32,"text":"  'google': 'https://www.google.com/search?q={}&num=20',"},{"line":33,"text":"}"},{"line":34,"text":""},{"line":35,"text":"for q in queries:"},{"line":36,"text":"    for name, tmpl in engines.items():"},{"line":37,"text":"        url = tmpl.format(urllib.parse.quote(q))"},{"line":38,"text":"        try:"},{"line":39,"text":"            st, body = fetch(url)"},{"line":40,"text":"            txt = clean(body)"},{"line":41,"text":"            # locate occurrences of key terms"},{"line":42,"text":"            hits = []"},{"line":43,"text":"            for m in re.finditer(r'(Duan Yihe|Yihe Duan)', txt, re.I):"},{"line":44,"text":"                s = max(0, m.start()-300); e = min(len(txt), m.end()+400)"},{"line":45,"text":"                hits.append(txt[s:e])"},{"line":46,"text":"            print('=' * 100)"},{"line":47,"text":"            print('QUERY', q, '| ENGINE', name, '| STATUS', st, '| LEN', len(body))"},{"line":48,"text":"            seen = set()"},{"line":49,"text":"            for h in hits[:6]:"},{"line":50,"text":"                k = h[:120]"},{"line":51,"text":"                if k in seen: continue"},{"line":52,"text":"                seen.add(k)"},{"line":53,"text":"                print('  ...', h)"},{"line":54,"text":"        except Exception as e:"},{"line":55,"text":"            print('ERR', q, name, repr(e))"}],"offset":0,"path":"search2.py","truncated":false},"status":"succeeded"}}