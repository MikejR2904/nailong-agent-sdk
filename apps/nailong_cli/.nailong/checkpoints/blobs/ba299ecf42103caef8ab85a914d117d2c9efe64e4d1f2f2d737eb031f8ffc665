"""The interactive loop: read a line, run a command or a turn, handle interrupts."""

from __future__ import annotations

import time

from .commands import COMMANDS, HELP, handle
from .cost import BudgetReached
from .modes import MODE_HELP
from .shell import run_shell
from .state import ReplState
from .turns import PromptRefused, run_turn, switch_agent

INTERRUPT_WINDOW_SECONDS = 2.0
PROMPT = "> "
_PROCEED = {"y": "accept-edits", "d": "default"}
CYCLE = ("default", "accept-edits", "auto", "plan")


def cycle_mode(state: ReplState) -> None:
    current = state.parts.mode.value
    following = CYCLE[(CYCLE.index(current) + 1) % len(CYCLE)] if current in CYCLE else CYCLE[0]
    state.parts.mode.set(following)
    state.mode_dirty = True


def toolbar_text(state: ReplState) -> str:
    parts = state.parts
    spent = f" | spent {parts.spending.total}" if parts.spending.total else ""
    return (
        f" {state.config.model} | mode {parts.mode.value} (Shift+Tab) | "
        f"{state.sandbox_label} | session {state.session.id}{spent} "
    )


def command_names(state: ReplState) -> list[str]:
    return sorted({f"/{name}" for name in COMMANDS} | {f"/{name}" for name in state.user_commands})


def command_descriptions(state: ReplState) -> dict[str, str]:
    described = {f"/{name}": text.split(":", 1)[-1].strip() for name, text in HELP.items()}
    described.update({f"/{name}": "your command" for name in state.user_commands})
    return {name: described.get(name, "") for name in command_names(state)}


def mode_hint(state: ReplState) -> str:
    mode = state.parts.mode.value
    return f"{mode} mode: {MODE_HELP[mode]}  (shift+tab to change)"


def shell_line(state: ReplState, command: str) -> None:
    if not command.strip():
        return
    try:
        record = state.runner.run(run_shell(command, state.project))
    except KeyboardInterrupt:
        state.console.line("\nCancelled.")
        return
    state.console.line(record.output.rstrip())
    if not record.successful:
        state.console.line(state.console.style(f"  exit {record.return_code}", "yellow"))


def guarded_turn(state: ReplState, text: str):
    try:
        return run_turn(state, text)
    except (BudgetReached, PromptRefused) as error:
        state.console.error(str(error))
        return None


def after_plan(state: ReplState) -> None:
    console = state.console
    if state.parts.mode.value != "plan" or not console.interactive:
        return
    choice = console.ask(
        "Carry out this plan?  [y] yes, accepting edits  [d] yes, asking each time  [n] no > "
    ).lower()
    if choice not in _PROCEED:
        return
    switch_agent(state, mode=_PROCEED[choice])
    console.line(f"  mode is now {_PROCEED[choice]} ({MODE_HELP[_PROCEED[choice]]})")
    guarded_turn(state, "Carry out the plan you just proposed.")


def repl(state: ReplState) -> None:
    console = state.console
    last_interrupt = float("-inf")
    while True:
        try:
            line = state.reader.read(PROMPT)
        except EOFError:
            return
        except KeyboardInterrupt:
            now = time.monotonic()
            if now - last_interrupt <= INTERRUPT_WINDOW_SECONDS:
                return
            last_interrupt = now
            console.line("\nPress Ctrl+C again to exit.")
            continue
        if not line:
            continue
        if state.mode_dirty and not line.startswith(("/", "!")):
            switch_agent(state)
            state.mode_dirty = False
        if line.startswith("!"):
            shell_line(state, line[1:])
        elif line.startswith("/"):
            if not handle(state, line):
                return
        elif guarded_turn(state, line) is not None:
            after_plan(state)
